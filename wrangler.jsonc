{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "medshield-ai-web",
  "main": "./src/worker.js",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "medshield-ai-db",
      "database_id": "f3073bbe-f942-43ba-8db2-337bd6847f87",
      "migrations_dir": "./migrations"
    }
  ]
}
